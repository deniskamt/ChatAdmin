# Токен бота, выданный @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Username бота без @ (для справки/проверки при запуске), напр. my_rules_bot
BOT_USERNAME=

# Ссылка на страницу правил в Telegraph (получите через `python create_telegraph.py`).
# Открывается по inline-кнопке под постом. Обязательно.
RULES_URL=https://telegra.ph/Pravila-chata-01-01

# Текст сообщения над кнопкой.
COMMENT_TEXT=👇 Правила нашего чата:

# Подпись inline-кнопки со ссылкой на правила.
BUTTON_TEXT=📜 Правила чата

# (Необязательно) Ограничить бота одним каналом.
# Можно задать @username канала (проще) и/или числовой id. Если оба пусты —
# бот отвечает на автопересылки из любого канала, где состоит группа обсуждения.
CHANNEL_USERNAME=your_channel
CHANNEL_ID=

# --- Аукцион (меню в личке бота) ---

# id администраторов через запятую (узнать свой id можно у @userinfobot).
# Они получают заявки на пост и могут добавлять/снимать лоты (/addlot, /lots, /dellot).
ADMIN_IDS=

# Анонимность ставки выбирает сам пользователь при каждой ставке — настройки нет.

# Путь к файлу базы данных (лоты и ставки). На Railway смонтируйте Volume и
# укажите путь внутри него (напр. /data/auction.db), иначе данные пропадут при
# передеплое.
DB_PATH=auction.db
